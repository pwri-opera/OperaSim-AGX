LinearSpringDamperMate is Mate:
    .doc: """
The LinearSpringDamperMate adds stiffness and damping parameters to the suspension mate.
"""
    spring_damping is Physics.Interactions.Dissipation.MechanicalDamping:
        damping_constant: 3333333
    spring_constant is Physics.Interactions.Flexibility.LinearElastic:
        stiffness: 100000000
